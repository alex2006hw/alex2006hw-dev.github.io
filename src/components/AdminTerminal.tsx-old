
import React, { useEffect, useRef, useState, useMemo } from 'react';
import { Terminal } from 'xterm';
import { FitAddon } from 'xterm-addon-fit';
import 'xterm/css/xterm.css';
import { useDatabase } from '../hooks/useDatabase';
import _ from 'lodash';

declare global { interface Window { v86: any; V86Starter: any; } }

// ------------------------------------------------------------------
// OS CONFIGURATION MAP
// Mapped to assets found in public/assets/v86/
// ------------------------------------------------------------------
const OS_CONFIGS: any = {
    'linux4': {
        name: 'Linux 4 (Buildroot)',
        cdrom: { url: "/assets/v86/linux4.iso" },
        memory_size: 64 * 1024 * 1024,
        vga_memory_size: 8 * 1024 * 1024,
        cmdline: "console=ttyS0 root=/dev/sr0" // Serial output optimization
    },
    'linux3': {
        name: 'Linux 3',
        cdrom: { url: "/assets/v86/linux3.iso" },
        memory_size: 64 * 1024 * 1024,
        vga_memory_size: 8 * 1024 * 1024,
        cmdline: "console=ttyS0"
    },
    'linux2': {
        name: 'Linux 2.6',
        cdrom: { url: "/assets/v86/linux.iso" },
        memory_size: 48 * 1024 * 1024,
        vga_memory_size: 8 * 1024 * 1024,
        cmdline: "console=ttyS0"
    },
    'bzimage': {
        name: 'Buildroot (BzImage)',
        // bzimage kernel direct boot
        bzimage: { url: "/assets/v86/buildroot-bzimage68.bin" }, 
        cmdline: "console=ttyS0 root=/dev/ram0 rw",
        memory_size: 64 * 1024 * 1024,
    },
    'tinycore': {
        name: 'TinyCore Linux 11',
        cdrom: { url: "/assets/v86/TinyCore-11.0.iso" },
        memory_size: 128 * 1024 * 1024,
        vga_memory_size: 8 * 1024 * 1024,
        autostart: true
    },
    'kolibri': {
        name: 'KolibriOS (GUI)',
        fda: { url: "/assets/v86/kolibri.img" },
        memory_size: 64 * 1024 * 1024,
        vga_memory_size: 8 * 1024 * 1024
    },
    'windows101': {
        name: 'Windows 1.01',
        fda: { url: "/assets/v86/windows101.img" },
        memory_size: 16 * 1024 * 1024,
        vga_memory_size: 2 * 1024 * 1024
    },
    'freedos': {
        name: 'FreeDOS 7.22',
        fda: { url: "/assets/v86/freedos722.img" },
        memory_size: 32 * 1024 * 1024
    },
    'msdos': {
        name: 'MS-DOS',
        fda: { url: "/assets/v86/msdos.img" },
        memory_size: 16 * 1024 * 1024
    },
    'openbsd': {
        name: 'OpenBSD (Floppy)',
        fda: { url: "/assets/v86/openbsd-floppy.img" },
        memory_size: 64 * 1024 * 1024
    },
    'oberon': {
        name: 'Oberon',
        fda: { url: "/assets/v86/oberon.img" },
        memory_size: 32 * 1024 * 1024
    },
    'mobius': {
        name: 'Mobius',
        fda: { url: "/assets/v86/mobius-fd-release5.img" },
        memory_size: 32 * 1024 * 1024
    },
    'os8': {
        name: 'OS/8',
        fda: { url: "/assets/v86/os8.img" },
        memory_size: 16 * 1024 * 1024
    }
};

export const AdminTerminal: React.FC = () => {
    const terminalRef = useRef<HTMLDivElement>(null);
    const [v86, setV86] = useState<any>(null);
    const [selectedOS, setSelectedOS] = useState('linux4');
    const [status, setStatus] = useState("Idle");
    const { worker: dbWorker } = useDatabase();

    const workerRef = useRef(dbWorker);
    useEffect(() => { workerRef.current = dbWorker; }, [dbWorker]);

    // --- SAVE LOGIC ---
    const performSave = (emulator: any, os: string, isAuto: boolean) => {
        if (!emulator || !workerRef.current) return;
        setStatus(isAuto ? "Auto-Saving..." : "Saving...");

        emulator.save_state((error: any, arrayBuffer: ArrayBuffer) => {
            if (error) { console.error("v86 Save Error:", error); return; }
            
            let binary = '';
            const bytes = new Uint8Array(arrayBuffer);
            const len = bytes.byteLength;
            for (let i = 0; i < len; i++) { binary += String.fromCharCode(bytes[i]); }
            const base64String = btoa(binary);

            const name = isAuto ? `AutoSave_${os}` : `Snapshot_${os}_${Date.now()}`;
            const date = new Date().toISOString();
            const sql = `INSERT INTO v86_states (os_type, name, date, state_blob) VALUES ('${os}', '${name}', '${date}', '${base64String}')`;

            workerRef.current.exec(sql).then(() => setStatus("State Saved.")).catch((e: any) => setStatus("Save Failed: " + e));
        });
    };

    const debouncedSave = useMemo(
        () => _.debounce((emulator, os) => performSave(emulator, os, true), 10000), 
        []
    );
    useEffect(() => () => debouncedSave.cancel(), [debouncedSave]);

    // --- TERMINAL LIFECYCLE ---
    useEffect(() => {
        // Cleanup previous
        if (v86) { v86.stop(); setV86(null); }
        if (!terminalRef.current) return;
        
        terminalRef.current.innerHTML = "";
        
        // 1. Initialize xterm (Wait for dimensions)
        const initXterm = () => {
            if (!terminalRef.current || terminalRef.current.clientWidth === 0) {
                // Poll until visible
                requestAnimationFrame(initXterm);
                return;
            }
            
            const term = new Terminal({ cursorBlink: true, fontSize: 14, fontFamily: 'monospace', theme: { background: '#111' } });
            const fitAddon = new FitAddon();
            term.loadAddon(fitAddon);
            term.open(terminalRef.current);
            
            try { fitAddon.fit(); } catch(e) {}
            
            // Handle Resize
            const resizeObserver = new ResizeObserver(() => {
                requestAnimationFrame(() => { try { fitAddon.fit(); } catch(e){} });
            });
            resizeObserver.observe(terminalRef.current);
            
            term.write(`\x1b[32m>>> Booting ${OS_CONFIGS[selectedOS].name}...\x1b[0m\r\n`);
            startV86(term);

            return { term, resizeObserver };
        };

        let activeTerm: any = null;

        const startV86 = (term: Terminal) => {
            // Check library
            if (typeof window.V86Starter !== 'function') {
                const s = document.createElement('script');
                s.src = "/assets/v86/libv86.js";
                s.onload = () => boot(term);
                s.onerror = () => term.write("\x1b[31mError: Failed to load /assets/v86/libv86.js\x1b[0m\r\n");
                document.body.appendChild(s);
            } else {
                boot(term);
            }
        };

        const boot = (term: Terminal) => {
            try {
                const config = {
                    wasm_path: "/assets/v86/v86.wasm",
                    bios: { url: "/assets/v86/seabios.bin" },
                    vga_bios: { url: "/assets/v86/vgabios.bin" },
                    screen_container: document.getElementById("screen_container"),
                    autostart: true,
                    disable_mouse: true,
                    ...OS_CONFIGS[selectedOS]
                };

                // @ts-ignore
                const emulator = new window.V86Starter(config);

                emulator.add_listener("serial0-output-char", (char: string) => term.write(char));
                term.onData((data) => {
                    emulator.serial0_send(data);
                    setStatus("Active");
                    debouncedSave(emulator, selectedOS);
                });

                setV86(emulator);
            } catch (e: any) {
                term.write(`\x1b[31mBoot Crash: ${e.message}\x1b[0m\r\n`);
            }
        };

        // Start Init Loop
        requestAnimationFrame(initXterm);

        return () => {
            if (activeTerm) {
                activeTerm.resizeObserver.disconnect();
                activeTerm.term.dispose();
            }
            if (v86) v86.stop();
        };
        // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [selectedOS]);

    return (
        <div style={{ height: '100%', display: 'flex', flexDirection: 'column', gap: 10 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '10px', background: '#222' }}>
                <div style={{ display: 'flex', gap: 15, alignItems: 'center' }}>
                    <h3 style={{margin:0}}>VM</h3>
                    <select 
                        value={selectedOS} 
                        onChange={(e) => { if(window.confirm("Switch OS? Unsaved progress lost.")) setSelectedOS(e.target.value); }}
                        style={{ padding: '5px 10px', background: '#333', color: 'white', border: '1px solid #555', borderRadius: 4 }}
                    >
                        {Object.keys(OS_CONFIGS).map(key => (
                            <option key={key} value={key}>{OS_CONFIGS[key].name}</option>
                        ))}
                    </select>
                </div>
                <div style={{ display: 'flex', gap: 10, alignItems: 'center' }}>
                    <span style={{ fontSize: '0.8em', color: status.includes("Save") ? 'lime' : '#888' }}>{status}</span>
                    <button onClick={() => performSave(v86, selectedOS, false)} style={{ padding: '6px 12px', background: '#0070f3', color: 'white', border: 'none', borderRadius: 4, cursor: 'pointer' }}>
                        Save State
                    </button>
                </div>
            </div>
            
            <div style={{ flex: 1, background: 'black', padding: 10, position: 'relative', minHeight: 0 }}>
                <div ref={terminalRef} style={{ height: '100%', width: '100%' }}></div>
            </div>
            <div id="screen_container" style={{ display: 'none' }}></div>
        </div>
    );
};
